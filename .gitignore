# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python (scripts/*.py) — compiled caches
__pycache__/
*.pyc

/lib/generated/prisma

# Ad-hoc deployment/admin scripts that historically embedded server credentials.
# deploy.ps1 is no longer among them: it is the committed twin of deploy.sh and
# takes the key as -Key or $env:DEPLOY_KEY, exactly as deploy.sh does, so there
# is nothing secret in it to leak. Anything you write locally that DOES hold a
# credential belongs here, not in the tree.
check.ps1
secrets.local.json
prisma/dev.db
HANDOFF.md
# A session's own handoff notes, like HANDOFF.md: written locally, read locally.
claudehandoff.md

# Generated by deploy.sh on the server; not committed
maintenance.html

# Uploaded printer driver files (stored on the server filesystem)
uploads/

# Local Claude Code settings, tooling worktrees, and scratch work
.claude/
scratch/

# Workstation provisioning scripts (v3.100). They run on a PC being built, not
# on the server, and they carry hard-coded local administrator passwords - a
# repository is the one place a password cannot be taken back out of.
scripts/setup-new-pc.ps1
scripts/setup-users.ps1
scripts/setup-without-lenovo.ps1
scripts/setup-workstation.ps1
scripts/update-all.ps1
scripts/sync-to-usb.ps1
scripts/Run-*.bat
scripts/without-lenovo.bat
